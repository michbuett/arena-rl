([
    ("charge", Active((
        name: "Charge",
        keywords: [Action],
        actions: [(
            kind: Action (
                target: Oneself,
                template: (
                    name: "Charge Vulnerability",
                    fx: SelfTxt("Charge!"),
                    check: NoCheck(([
                        (Success, Normal, TempEffect(
                            effect: BoonOrBane(-1),
                            turns: 1,
                            keywords: [Reaction, Physical, Melee],
                            descr: "Vulnerable (-1 to defence)"
                        ))
                    ])),
                ),
            ),
            inputs: [(
                input_id: ("charge_path"),
                prompt: "Select a path for the charge action",
                input_kind: Path(length: 3),
            )],
        ), (
            kind: MoveTo(
                path: ("charge_path"),
            ),
            inputs: [],
        ), (
            kind: Action (
                target: SingleActor(target_actor: ("target")),
                template: (
                    name: "Charge attack",
                    fx: SingleTargetMeleeAttack("fx-hit-1"),
                    check: Check(
                        effects: ([
                            (Success, Minor, DamageTarget(3)),
                            (Success, Normal, DamageTarget(4)),
                            (Success, Major, DamageTarget(5)),
                            (Success, Major, ArmorBreak),
                            (Complication, Normal, DamageTarget(1)),
                            (Complication, Major, DamageTarget(2)),
                        ]),
                        risky: true,
                        keywords: [Action, Physical, Melee],
                        attribute: PhysicalStr,
                    )
                ),
            ),
            inputs: [(
                input_id: ("target"),
                prompt: "Select an enemy to attack",
                input_kind: TargetActor(
                    filter: [SameEntity(false), SameTeam(false), WithinReach(1)],
                ),
            ), (
                input_id: ("defence"),
                prompt: "How do you want to defend yourself?",
                input_kind: Maneuver(
                    actor: ("target"),
                    filter: [Reaction],
                    is_reaction: true,
                ),
            )],
        )],
        speed: Slow,
    ))),

    ("sucker-charge", Active((
        name: "Charge",
        keywords: [Action],
        actions: [(
            kind: Action (
                target: Oneself,
                template: (
                    name: "Charge Vulnerability",
                    fx: SelfTxt("Shhriiek"),
                    check: NoCheck(([
                        (Success, Normal, TempEffect(
                            effect: BoonOrBane(-1),
                            turns: 1,
                            keywords: [Reaction, Physical, Melee],
                            descr: "Vulnerable (-1 to defence)"
                        ))
                    ])),
                ),
            ),
            inputs: [(
                input_id: ("charge_path"),
                prompt: "Select a path for the charge action",
                input_kind: Path(length: 4),
            )],
        ), (
            kind: MoveTo(
                path: ("charge_path"),
            ),
            inputs: [],
        ), (
            kind: Action (
                target: SingleActor(target_actor: ("target")),
                template: (
                    name: "Charge attack",
                    fx: SingleTargetMeleeAttack("fx-hit-3"),
                    check: Check(
                        effects: ([
                            (Success, Minor, DamageTarget(2)),
                            (Success, Normal, DamageTarget(3)),
                            (Success, Major, DamageTarget(4)),
                            (Success, Major, ArmorBreak),
                            (Complication, Major, DamageTarget(1)),
                        ]),
                        risky: true,
                        keywords: [Action, Physical, Melee],
                        attribute: PhysicalStr,
                    )
                ),
            ),
            inputs: [(
                input_id: ("target"),
                prompt: "Select an enemy to attack",
                input_kind: TargetActor(
                    filter: [SameEntity(false), SameTeam(false), WithinReach(1)],
                ),
            ), (
                input_id: ("defence"),
                prompt: "The sucker snaps at you.\nHow do you want to defend yourself?",
                input_kind: Maneuver(
                    actor: ("target"),
                    filter: [Reaction],
                    is_reaction: true,
                ),
            )],
        )],
        speed: Normal,
    ))),

    ("attack-sword-01", Active((
        name: "Attack",
        keywords: [Action],
        actions: [(
            kind: Action (
                target: SingleActor (
                    target_actor: ("target"),
                ),
                template: (
                    name: "Swing Sword",
                    fx: SingleTargetMeleeAttack("fx-hit-1"),
                    check: Check(
                        effects: ([
                            (Success, Minor, DamageTarget(4)),
                            (Success, Normal, DamageTarget(2)),
                            (Success, Major, DamageTarget(2)),
                        ]),
                        risky: false,
                        keywords: [Action, Physical, Melee],
                        attribute: PhysicalStr,
                    )
                ),
            ),
            inputs: [(
                input_id: ("target"),
                prompt: "Select an enemy to attack",
                input_kind: TargetActor (
                    filter: [SameEntity(false), SameTeam(false), WithinReach(1)],
                ),
            ), (
                input_id: ("defence"),
                prompt: "How do you want to defend yourself?",
                input_kind: Maneuver (
                    actor: ("target"),
                    filter: [Reaction],
                    is_reaction: true,
                ),
            )],
        )],
        speed: Normal,
    ))),

    ("move", Active((
        name: "Move",
        keywords: [Action],
        actions: [(
            kind: MoveTo (
                path: ("path"),
            ),
            inputs: [(
                input_id: ("path"),
                prompt: "Select a path",
                input_kind: Path (
                    length: 3,
                ),
            )],
        )],
        speed: Quick,
    ))),

    ("spur", Active((
        name: "Spur on",
        keywords: [Action],
        actions: [(
            kind: ChangeActivation(
                target_actor: ("target"),
                activation: ("activation"),
            ),
            inputs: [(
                input_id: ("target"),
                prompt: "Select an ally to spur on",
                input_kind: TargetActor (
                    filter: [SameTeam(true)],
                ),
            ), (
                input_id: ("activation"),
                prompt: "Select a card from your hand",
                input_kind: HandCard(
                    actor: ("target"),
                ),
            )],
        )],
        speed: Free,
    ))), // END spur

    ("dodge", Reactive((
        name: "Dodge",
        keywords: [Reaction],
        actions: [(
            kind: MoveTo (
                path: ("dodge_path"),
            ),
            inputs: [ (
                input_id: ("dodge_path"),
                prompt: "Select a path",
                input_kind: Path ( length: 2 ),
            )],
        ), (
            kind: Action (
                target: Oneself,
                template: (
                    name: "Dodge",
                    fx: SelfTxt("Dodge"),
                    check: Check(
                        effects: ([
                            (Success, Minor, Protection(2)),
                            (Success, Normal, Protection(6)),
                            (Success, Major, Protection(10)),
                            (Complication, Minor, TempEffect(
                                effect: BoonOrBane(-1),
                                turns: 1,
                                keywords: [Action, Physical, Melee],
                                descr: "Off balance (-1 to attack)"
                            )),
                            (Complication, Major, ArmorBreak),
                        ]),
                        risky: true,
                        keywords: [Reaction, Physical, Melee],
                        attribute: PhysicalAg,
                    )
                ),
            ),
            inputs: [],
        )],
    ))), // END dodge
])
